#!markdown

# Byg en Agent – teori + øvelse
*55 minutter (15 min teori + 40 min øvelse)*

## Teori: The Agentic Loop

### "LLM in a loop with tools" - Demystificeret

```
┌──────────────────────────────────────────────────────┐
│                    AGENTIC LOOP                       │
│                                                       │
│   ┌─────────┐    ┌─────────┐    ┌──────────────┐    │
│   │  User   │───►│   LLM   │───►│ Tool Call?   │    │
│   │ Prompt  │    │         │    │              │    │
│   └─────────┘    └─────────┘    └──────┬───────┘    │
│                       ▲                 │            │
│                       │            Yes  │  No        │
│                       │                 ▼            │
│                  ┌────┴────┐      ┌──────────┐      │
│                  │ Append  │◄─────│ Execute  │      │
│                  │ Result  │      │  Tool    │      │
│                  └─────────┘      └──────────┘      │
│                                         │            │
│                                    ┌────▼────┐      │
│                                    │  Done   │      │
│                                    └─────────┘      │
└──────────────────────────────────────────────────────┘
```

#!markdown

### Pseudokode

```csharp
var messages = [userPrompt];

while (!done && iterations < maxIterations)
{
    var response = await llm.Complete(messages);

    if (response.HasToolCalls)
    {
        foreach (var toolCall in response.ToolCalls)
        {
            var result = ExecuteTool(toolCall);
            messages.Add(new ToolResult(toolCall.Id, result));
        }
    }
    else
    {
        done = true;
        return response.Text;
    }
}
```

### Hvornår stopper loopet?

1. **LLM returnerer tekst uden tool calls** - Færdig!
2. **Max iterations nået** - Sikkerhedsgrænse
3. **Fejl** - Tool execution fejler

#!markdown

## Øvelse 3: Byg en EV Charging Assistant Agent
*40 minutter*

### Mål

Implementer en komplet agentic loop der kan:
- Søge efter ladere
- Tjekke lader-status
- Beregne omkostninger

#!markdown

### Step 1: Installer Anthropic SDK

#!csharp

#r "nuget: Anthropic.SDK, 3.2.4"

#!markdown

### Step 2: Definer vores Tools

#!csharp

using Anthropic.SDK.Common;
using Anthropic.SDK.Messaging;
using System.Text.Json;

// Tool definitions for the LLM
var tools = new List<Tool>
{
    new Tool
    {
        Name = "search_chargers",
        Description = "Search for EV chargers by location or minimum power. Returns list of matching chargers.",
        InputSchema = new InputSchema
        {
            Type = "object",
            Properties = new Dictionary<string, Property>
            {
                ["location"] = new Property { Type = "string", Description = "Location to search, e.g. 'Nørrebro' or 'København'" },
                ["min_power_kw"] = new Property { Type = "integer", Description = "Minimum power in kW (optional)" }
            },
            Required = new[] { "location" }
        }
    },
    new Tool
    {
        Name = "get_charger_status",
        Description = "Get real-time status of a specific charger including availability.",
        InputSchema = new InputSchema
        {
            Type = "object",
            Properties = new Dictionary<string, Property>
            {
                ["charger_id"] = new Property { Type = "string", Description = "The charger ID, e.g. CPH-001" }
            },
            Required = new[] { "charger_id" }
        }
    },
    new Tool
    {
        Name = "calculate_charging_cost",
        Description = "Calculate the cost to charge a specific amount at a given hour.",
        InputSchema = new InputSchema
        {
            Type = "object",
            Properties = new Dictionary<string, Property>
            {
                ["kwh"] = new Property { Type = "number", Description = "Amount of energy in kWh" },
                ["hour"] = new Property { Type = "integer", Description = "Hour of day (0-23)" }
            },
            Required = new[] { "kwh", "hour" }
        }
    }
};

Console.WriteLine($"Defined {tools.Count} tools for the agent");

#!markdown

### Step 3: Tool Execution Functions

#!csharp

// Tool execution - kobler tool calls til vores implementationer
string ExecuteTool(string toolName, JsonElement input)
{
    return toolName switch
    {
        "search_chargers" => SearchChargers(input),
        "get_charger_status" => GetChargerStatusJson(input),
        "calculate_charging_cost" => CalculateCostJson(input),
        _ => throw new ArgumentException($"Unknown tool: {toolName}")
    };
}

string SearchChargers(JsonElement input)
{
    var location = input.GetProperty("location").GetString()!.ToLower();
    var minPower = input.TryGetProperty("min_power_kw", out var mp) ? mp.GetInt32() : 0;

    var results = chargers.Values
        .Where(c => c.Location.ToLower().Contains(location) || location.Contains("køben"))
        .Where(c => c.PowerKw >= minPower)
        .Select(c => new { c.Id, c.Name, c.Location, c.PowerKw, c.Type })
        .ToList();

    return JsonSerializer.Serialize(results);
}

string GetChargerStatusJson(JsonElement input)
{
    var chargerId = input.GetProperty("charger_id").GetString()!;

    if (!chargers.TryGetValue(chargerId, out var charger))
        return JsonSerializer.Serialize(new { error = $"Unknown charger: {chargerId}" });

    var hasSession = activeSessions.TryGetValue(chargerId, out var session);

    var status = new
    {
        charger_id = chargerId,
        name = charger.Name,
        available = !hasSession,
        power_kw = charger.PowerKw,
        current_session = hasSession ? session.vehicleId : null,
        energy_delivered_kwh = hasSession ? session.kwh : (double?)null
    };

    return JsonSerializer.Serialize(status);
}

string CalculateCostJson(JsonElement input)
{
    var kwh = input.GetProperty("kwh").GetDouble();
    var hour = input.GetProperty("hour").GetInt32();

    decimal pricePerKwh = hour switch
    {
        >= 0 and < 6 => 1.50m,
        >= 6 and < 17 => 2.50m,
        >= 17 and < 21 => 4.00m,
        >= 21 and <= 23 => 2.50m,
        _ => 2.50m
    };

    var tariff = hour switch
    {
        >= 0 and < 6 => "off-peak",
        >= 17 and < 21 => "peak",
        _ => "normal"
    };

    return JsonSerializer.Serialize(new
    {
        kwh,
        hour,
        tariff,
        price_per_kwh = pricePerKwh,
        total_cost_dkk = (decimal)kwh * pricePerKwh
    });
}

Console.WriteLine("Tool execution functions ready");

#!markdown

### Step 4: Implementer The Agentic Loop

**Din opgave:** Udfyld TODO-sektionerne i loopet nedenfor.

#!csharp

using Anthropic.SDK;

async Task<string> RunAgent(string userQuery, string apiKey)
{
    var client = new AnthropicClient(apiKey);

    var messages = new List<Message>
    {
        new Message(RoleType.User, userQuery)
    };

    var systemPrompt = """
        Du er en hjælpsom EV-ladnings assistent for ChargeSmart netværket i København.
        Du hjælper brugere med at finde ladere, tjekke tilgængelighed og beregne omkostninger.
        Svar altid på dansk. Vær venlig og informativ.
        """;

    const int maxIterations = 10;
    var iterations = 0;

    while (iterations < maxIterations)
    {
        iterations++;
        Console.WriteLine($"\n--- Iteration {iterations} ---");

        var request = new MessageRequest
        {
            Model = "claude-sonnet-4-20250514",
            MaxTokens = 1024,
            System = systemPrompt,
            Messages = messages,
            Tools = tools
        };

        var response = await client.Messages.CreateAsync(request);

        Console.WriteLine($"Stop reason: {response.StopReason}");

        // TODO: Tjek om response indeholder tool calls
        // Hint: response.Content kan indeholde ToolUseContent objekter

        if (response.StopReason == "tool_use")
        {
            // Tilføj assistant response til messages
            messages.Add(new Message(RoleType.Assistant, response.Content));

            // TODO: Loop gennem tool calls og eksekver dem
            // 1. Find alle ToolUseContent i response.Content
            // 2. For hver tool call: kald ExecuteTool(name, input)
            // 3. Opret ToolResultContent med resultat
            // 4. Tilføj tool results som User message

            var toolResults = new List<ContentBlock>();

            foreach (var content in response.Content)
            {
                if (content is ToolUseContent toolUse)
                {
                    Console.WriteLine($"Executing tool: {toolUse.Name}");

                    // TODO: Eksekver tool og tilføj resultat
                    // var result = ExecuteTool(toolUse.Name, toolUse.Input);
                    // toolResults.Add(new ToolResultContent { ... });

                    throw new NotImplementedException("Implementer tool execution!");
                }
            }

            messages.Add(new Message(RoleType.User, toolResults));
        }
        else
        {
            // Ingen flere tool calls - returner final response
            var textContent = response.Content
                .OfType<TextContent>()
                .FirstOrDefault();

            return textContent?.Text ?? "Ingen respons";
        }
    }

    return "Max iterations reached";
}

Console.WriteLine("Agent function defined - klar til test!");

